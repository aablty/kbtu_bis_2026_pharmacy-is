DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pharmacy
JWT_SECRET=change-me
FRONTEND_BASE_URL=http://localhost:5173

# AI assistant (feat/assistant) - leave unset until that branch starts
GEMINI_API_KEY=

# File storage - optional. Leave unset to use the local-disk fallback
# (server/uploads/, served at /uploads). Set to a real
# cloudinary://<api_key>:<api_secret>@<cloud_name> value (one clean string,
# no doubled "CLOUDINARY_URL=" prefix) to upload to Cloudinary instead.
CLOUDINARY_URL=

# Google sign-in (feat/auth-google) - leave unset until that branch starts.
# Client ID from a Google Cloud OAuth 2.0 Client (console.cloud.google.com ->
# APIs & Services -> Credentials). Free for standard sign-in volume.
GOOGLE_CLIENT_ID=

# Real email delivery - optional. Leave SMTP_HOST unset to keep using
# ConsoleEmailSender (logs the OTP instead of sending it). For Gmail:
# smtp.gmail.com, port 587, and an App Password as SMTP_PASSWORD (Gmail
# requires one instead of the account password for third-party SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
